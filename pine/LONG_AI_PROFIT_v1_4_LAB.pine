//@version=6
strategy("LONG AI PROFIT v1.4 LAB | A / B / C", overlay=true, pyramiding=0,
     initial_capital=10000, default_qty_type=strategy.fixed,
     commission_type=strategy.commission.percent, commission_value=0.05, slippage=2,
     process_orders_on_close=false, calc_on_every_tick=false, calc_on_order_fills=false,
     max_labels_count=100)
// RESEARCH LAB: no broker orders. Test ONE strategy at a time.
// All 1D/4H values use previous CONFIRMED bars. No claim of profitability.
// Do not alter thresholds to fit historical screenshots. No stock RTH parity yet.

gM = "01 | Motor i mercat"
route = input.string("A · RETROCES", "Motor independent", options=["A · RETROCES", "B · RUPTURA-RETEST", "C · CONTINUACIO"], group=gM)
showPanel = input.bool(true, "Mostrar diagnostics", group=gM)
showAudit = input.bool(true, "Mostrar darreres sortides", group=gM)
showLevels = input.bool(true, "Mostrar nivells", group=gM)
btcPolicy = input.string("INFORMATIU", "Context BTC per altres criptos", options=["INFORMATIU", "OBLIGATORI", "DESACTIVAT"], group=gM)

// Parameters are fixed for scientific A/B/C comparison. Not optimized.
float riskFraction = 0.005
float allocationCap = 0.25
float stopBufferATR = 0.20
float chaseATR = 0.20
float costReserve = 0.002
float minRR = 2.0
int lifeBars = 3
int cooldownBars = 8

bool crypto = syminfo.type == "crypto"
if barstate.isfirst
    if timeframe.in_seconds() != 3600 or not chart.is_standard
        runtime.error("LONG AI v1.4: nomes espelmes normals 1H")
    if not crypto
        runtime.error("Accions pendents de validar sessions 1H/4H RTH. Prova criptomonedes Coinbase.")

// All requested values known at the start of the current 1H bar.
[dClose,d20,d50,d50prev,dRsi,dDollars,dRes,dHistory] = request.security(syminfo.tickerid,"D",
     [close[1],ta.ema(close,20)[1],ta.ema(close,50)[1],ta.ema(close,50)[6],
      ta.rsi(close,14)[1],ta.sma(close*volume,20)[1],ta.highest(high,60)[1],bar_index[1]],
     lookahead=barmerge.lookahead_on)
[fClose,fPrev,f20,f20prev,f50,fAtr,fVol,fVolAvg,fHistory] = request.security(syminfo.tickerid,"240",
     [close[1],close[2],ta.ema(close,20)[1],ta.ema(close,20)[4],ta.ema(close,50)[1],
      ta.atr(14)[1],volume[1],ta.sma(volume,20)[2],bar_index[1]],
     lookahead=barmerge.lookahead_on)
f_strength() =>
    [p,m,a] = ta.dmi(14,14)
    [p[1],m[1],a[1]]
[diPlus,diMinus,adx4] = request.security(syminfo.tickerid,"240",f_strength(),lookahead=barmerge.lookahead_on)
f_macd_hist() =>
    [m,s,h] = ta.macd(close,12,26,9)
    [h[1],h[2]]
[hist4,hist4prev] = request.security(syminfo.tickerid,"240",f_macd_hist(),lookahead=barmerge.lookahead_on)
[btcClose,btc50] = request.security("COINBASE:BTCUSD","240",
     [close[1],ta.ema(close,50)[1]],lookahead=barmerge.lookahead_on)

float ema1 = ta.ema(close,20)
float rsi1 = ta.rsi(close,14)
[m1,s1,h1] = ta.macd(close,12,26,9)
float atr1 = ta.atr(14)
float rvBase = ta.sma(volume,20)[1]
float rv1 = rvBase>0 ? volume/rvBase : na
float rv4 = fVolAvg>0 ? fVol/fVolAvg : na
float high20 = ta.highest(high[1],20)
float priorBreakCeiling = ta.highest(high[2],20)
float priorLow12 = ta.lowest(low[1],12)
float priorLow8 = ta.lowest(low[1],8)
float priorHigh8 = ta.highest(high[1],8)
float priorLow6 = ta.lowest(low[1],6)
float bbMid = ta.sma(close,20)
float bbRelWidth = bbMid>0 ? 4*ta.stdev(close,20)/bbMid : na
float bbWidthAvg = ta.sma(bbRelWidth,40)
float vwap = ta.vwap(hlc3)

bool historyOK = not na(dHistory) and dHistory>=69 and not na(fHistory) and fHistory>=59 and fAtr>0 and not na(rv1)
bool dailyOK = dClose>d50 and (d20>d50 or dClose>d20) and d50>=d50prev
bool fourOK = fClose>f50 and f20>=f50*0.995
bool strengthDI = diPlus>diMinus and adx4>=16
bool strengthMACD = hist4>=hist4prev
bool strengthSlope = fClose>fPrev
bool strengthVolume = not na(rv4) and rv4>=0.80
int strengthScore = (strengthDI?1:0)+(strengthMACD?1:0)+(strengthSlope?1:0)+(strengthVolume?1:0)
bool btcOK = btcPolicy!="OBLIGATORI" or syminfo.basecurrency=="BTC" or (not na(btcClose) and btcClose>btc50)
bool marketOK = historyOK and dailyOK and fourOK and btcOK and dDollars>=1000000 and strengthScore>=2
bool notExtended = close<=f20+2.0*fAtr
bool common = marketOK and notExtended

// A: reclaim within twelve 1H bars after a REAL visit to 4H support.
// Not all oscillators need to reverse on the same hour.
bool touchedSupport = priorLow12<=f20+.50*fAtr and priorLow12>=f50-.60*fAtr
float dipFromEMA = ta.lowest(low-ema1,12)[1]
bool hadDip = not na(dipFromEMA) and dipFromEMA<0
bool crossEma = ta.crossover(close,ema1)
bool aReclaim = close>open and close>ema1 and (crossEma or (close>high[1] and close[1]<ema1[1]*1.012))
bool signalA = common and touchedSupport and hadDip and aReclaim and rsi1>=47 and rsi1<=73 and rv1>=0.75

// B: first record a breakout; a separate later bar must retest it.
var float levelB = na
var int breakoutBar = na
bool initialBreak = barstate.isconfirmed and common and close>high20 and close[1]<=priorBreakCeiling and close>open and rv1>=1.20
if route=="B · RUPTURA-RETEST" and initialBreak and strategy.position_size==0 and na(breakoutBar)
    levelB:=high20
    breakoutBar:=bar_index
bool watchingB = not na(breakoutBar) and bar_index>breakoutBar and bar_index-breakoutBar<=12
bool signalB = common and watchingB and low<=levelB+.30*fAtr and low>=levelB-.60*fAtr and close>levelB and close>open and rv1>=0.80 and rsi1>=48
if not na(breakoutBar) and (bar_index-breakoutBar>12 or close<levelB-.70*fAtr)
    levelB:=na
    breakoutBar:=na

// C: continuation after a CLOSED 8-hour consolidation, not a chase of any green candle.
float baseWidth = priorHigh8-priorLow8
bool compressedBase = baseWidth>0 and baseWidth<=1.60*fAtr and priorLow8>f50-.20*fAtr
bool cImpulse = close>priorHigh8 and close>open and close>ema1 and rv1>=1.10 and rsi1>=52 and rsi1<=76
bool signalC = common and f20>f50 and strengthScore>=3 and compressedBase and cImpulse

bool routeSignal = route=="A · RETROCES" ? signalA : route=="B · RUPTURA-RETEST" ? signalB : signalC
float candidateTrigger = high+syminfo.mintick
float stopA = math.min(priorLow12,low)-stopBufferATR*fAtr
float stopB = math.min(math.min(priorLow6,low),levelB-.20*fAtr)-stopBufferATR*fAtr
float stopC = math.min(priorLow8,low)-stopBufferATR*fAtr
float candidateStop = route=="A · RETROCES"?stopA:route=="B · RUPTURA-RETEST"?stopB:stopC
float dist = candidateTrigger-candidateStop
float plannedCost = candidateTrigger*costReserve
float roomR = not na(dRes) and dRes>candidateTrigger+syminfo.mintick and dist>0 ? (dRes-candidateTrigger-plannedCost)/(dist+plannedCost) : 3.0
bool validPlan = candidateStop>0 and dist>syminfo.mintick and dist/candidateTrigger<=0.10 and roomR>=minRR and close<=f20+2.0*fAtr

var int placedAt = na
var int lastClosedBar = na
var float trigger = na
var float stop = na
var float target1 = na
var float target2 = na
var float sizeHalf = na
var float sizeOther = na
var float atrAtSignal = na
var float filledPrice = na
var float initialR = na
var float initialQty = na
var float peakHigh = na
var float dynamicStop = na
var int entryEpoch = na
var bool firstTargetFilled = false
var int handledExits = 0
var int entriesSeen = 0
var int checkedBars = 0
var int rejectedRegime = 0
var int rejectedSetup = 0
var int rejectedRisk = 0

bool orderPending = not na(placedAt) and strategy.position_size==0
bool waitCooldown = not na(lastClosedBar) and bar_index-lastClosedBar<8
bool orderSignal = barstate.isconfirmed and routeSignal and validPlan and strategy.position_size==0 and not orderPending and not waitCooldown
if barstate.isconfirmed
    checkedBars+=1
    if not common
        rejectedRegime+=1
    else if not routeSignal
        rejectedSetup+=1
    else if not validPlan
        rejectedRisk+=1

if orderSignal
    float perUnit = dist+plannedCost
    float qty = math.min(strategy.equity*riskFraction/perUnit,strategy.equity*allocationCap/candidateTrigger)
    if qty>0 and qty>=syminfo.mincontract
        placedAt:=bar_index
        trigger:=candidateTrigger
        stop:=candidateStop
        sizeHalf:=qty*.5
        sizeOther:=qty-sizeHalf
        atrAtSignal:=fAtr
        target1:=trigger+1.5*dist
        target2:=trigger+3.0*dist
        strategy.entry("LONG",strategy.long,qty=qty,stop=trigger,limit=trigger+.2*fAtr,comment=route)
        entriesSeen+=1
        if route=="B · RUPTURA-RETEST"
            levelB:=na
            breakoutBar:=na

// Brackets are placed while the entry is pending. On historical OHLC,
// simultaneous stop/target hits follow TradingView's broker emulator ordering.
if not na(placedAt) and strategy.position_size==0 and not na(stop)
    strategy.exit("TP1","LONG",qty=sizeHalf,stop=stop,limit=target1,comment_profit="TP1_PROFIT",comment_loss="STOP_1")
    strategy.exit("TP2","LONG",qty=sizeOther,stop=stop,limit=target2,comment_profit="TP2_PROFIT",comment_loss="STOP_2")
if orderPending and bar_index-placedAt>=lifeBars
    strategy.cancel("LONG")
    strategy.cancel("TP1")
    strategy.cancel("TP2")
    placedAt:=na
    trigger:=na
    stop:=na

bool opened = strategy.position_size>0 and strategy.position_size[1]<=0
if opened
    filledPrice:=strategy.position_avg_price
    initialR:=math.max(filledPrice-stop,syminfo.mintick)
    initialQty:=strategy.position_size
    target1:=filledPrice+1.5*initialR
    target2:=filledPrice+3.0*initialR
    dynamicStop:=stop
    peakHigh:=high
    entryEpoch:=time
    firstTargetFilled:=false

// Progress the position only when TP1 was truly taken at a PROFIT.
if strategy.closedtrades>handledExits
    for k=handledExits to strategy.closedtrades-1
        if not na(entryEpoch) and strategy.closedtrades.entry_time(k)>=entryEpoch and strategy.closedtrades.exit_comment(k)=="TP1_PROFIT"
            firstTargetFilled:=true
    handledExits:=strategy.closedtrades

if strategy.position_size>0
    peakHigh:=math.max(nz(peakHigh,high),high)
    if firstTargetFilled and barstate.isconfirmed
        dynamicStop:=math.max(dynamicStop,filledPrice+filledPrice*.001,close-2*atrAtSignal)
    if firstTargetFilled
        strategy.cancel("TP1")
        strategy.exit("TP2","LONG",qty=strategy.position_size,stop=dynamicStop,limit=target2,comment_profit="TP2_PROFIT",comment_loss="STOP_2")
    else
        strategy.exit("TP1","LONG",qty=sizeHalf,stop=dynamicStop,limit=target1,comment_profit="TP1_PROFIT",comment_loss="STOP_1")
        strategy.exit("TP2","LONG",qty=sizeOther,stop=dynamicStop,limit=target2,comment_profit="TP2_PROFIT",comment_loss="STOP_2")
    bool timeOut = time>=entryEpoch+7*86400000
    bool noProgress = time>=entryEpoch+3*86400000 and peakHigh<filledPrice+.5*initialR
    bool dust = strategy.position_size*close<1
    if barstate.isconfirmed and (timeOut or noProgress or dust)
        strategy.cancel("TP1")
        strategy.cancel("TP2")
        strategy.close("LONG",comment=dust?"RESIDU":timeOut?"TEMPS_7D":"SENSE_IMPULS_3D")

if strategy.position_size==0 and strategy.position_size[1]>0
    lastClosedBar:=bar_index
    strategy.cancel("TP1")
    strategy.cancel("TP2")
    placedAt:=na
    trigger:=na
    stop:=na
    filledPrice:=na
    initialR:=na
    peakHigh:=na
    entryEpoch:=na
    sizeHalf:=na
    sizeOther:=na
    firstTargetFilled:=false

string reason = not historyOK?"FALTA HISTORIAL":not btcOK?"CONTEXT BTC":not dailyOK?"1D NO ACOMPANYA":not fourOK?"4H NO ACOMPANYA":not notExtended?"MASSA ESTES":strengthScore<2?"FORCA INSUFICIENT":not routeSignal?"SENSE SETUP":not validPlan?"R/R O STOP":orderPending?"ORDRE PENDENT":"VIGILANCIA"
string status = strategy.position_size>0?"POSICIO SIMULADA":orderPending?"ORDRE PENDENT":orderSignal?"SENYAL 1H CONFIRMAT":reason
var table panel = table.new(position.top_right,2,11,border_width=1)
if barstate.islast and showPanel
    color navy=color.rgb(35,56,86)
    table.cell(panel,0,0,"LONG AI v1.4",bgcolor=navy,text_color=color.white)
    table.cell(panel,1,0,route,bgcolor=navy,text_color=color.white)
    table.cell(panel,0,1,"ESTAT")
    table.cell(panel,1,1,status)
    table.cell(panel,0,2,"1D / 4H")
    table.cell(panel,1,2,(dailyOK?"OK":"NO")+" / "+(fourOK?"OK":"NO"))
    table.cell(panel,0,3,"FORCA 4H (4)")
    table.cell(panel,1,3,str.tostring(strengthScore)+"/4 · ADX "+str.tostring(adx4,"#.0"))
    table.cell(panel,0,4,"RSI / RVOL 1H")
    table.cell(panel,1,4,str.tostring(rsi1,"#.0")+" / "+str.tostring(rv1,"#.00")+"x")
    table.cell(panel,0,5,"R/R TEORIC")
    table.cell(panel,1,5,str.tostring(roomR,"#.00")+"R | NO ORDRE")
    table.cell(panel,0,6,"BTC 4H")
    table.cell(panel,1,6,btcPolicy=="DESACTIVAT"?"OFF":btcClose>btc50?"FAVORABLE":"FEBLE")
    table.cell(panel,0,7,"VWAP / BB (INFO)")
    table.cell(panel,1,7,(close>vwap?"SOBRE":"SOTA")+" / "+(bbRelWidth<bbWidthAvg*.85?"COMPRESSIO":"NORMAL"))
    table.cell(panel,0,8,"BARRES BLOQUEJADES")
    table.cell(panel,1,8,"CONTEXT "+str.tostring(rejectedRegime)+" | SETUP "+str.tostring(rejectedSetup))
    table.cell(panel,0,9,"PLANS BLOQUEJATS")
    table.cell(panel,1,9,"STOP/RR "+str.tostring(rejectedRisk)+" | GENERATS "+str.tostring(entriesSeen))
    table.cell(panel,0,10,"MODE")
    table.cell(panel,1,10,"STRATEGY TESTER · NO BROKER")

plot(f20,"EMA20 4H confirmada",color.orange)
plot(f50,"EMA50 4H confirmada",color.blue)
plot(strategy.position_size>0?dynamicStop:na,"Stop vigent",color.red,style=plot.style_linebr)
plot(strategy.position_size>0?target1:na,"TP1",color.lime,style=plot.style_linebr)
plot(strategy.position_size>0?target2:na,"TP2",color.green,style=plot.style_linebr)
plotshape(orderSignal,title="Confirmacio candidata",style=shape.triangleup,location=location.belowbar,color=color.teal,size=size.tiny)

var table audit = table.new(position.bottom_right,3,7,border_width=1)
if barstate.islast and showAudit
    table.cell(audit,0,0,"SORTIDA UTC",bgcolor=color.rgb(35,56,86),text_color=color.white,text_size=size.tiny)
    table.cell(audit,1,0,"MOTIU",bgcolor=color.rgb(35,56,86),text_color=color.white,text_size=size.tiny)
    table.cell(audit,2,0,"PNL",bgcolor=color.rgb(35,56,86),text_color=color.white,text_size=size.tiny)
    for n=0 to 5
        int index=strategy.closedtrades-1-n
        int rowIndex=n+1
        if index>=0
            float p=strategy.closedtrades.profit(index)
            table.cell(audit,0,rowIndex,str.format_time(strategy.closedtrades.exit_time(index),"MM-dd HH:mm","UTC"),text_size=size.tiny)
            table.cell(audit,1,rowIndex,strategy.closedtrades.exit_comment(index),text_size=size.tiny)
            table.cell(audit,2,rowIndex,str.tostring(p,"#.##"),bgcolor=p>=0?color.rgb(220,243,226):color.rgb(252,225,224),text_size=size.tiny)
        else
            for col=0 to 2
                table.cell(audit,col,rowIndex,"",text_size=size.tiny)
