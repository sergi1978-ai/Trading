//@version=6
strategy("LONG AI PROFIT v1.6 LAB | C continuacio / B retest", overlay=true,
     pyramiding=0, initial_capital=10000, default_qty_type=strategy.fixed,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=2, process_orders_on_close=false,
     calc_on_every_tick=false, calc_on_order_fills=false,
     max_labels_count=100)
// INVESTIGACIO, NO ORDRES REALS. Nomes criptos spot USD/USDT, veles normals 1H.
// Hipotesis NOVES, NO optimitzades ni validades com a rendibles.
// Executar C i B PER SEPARAT, amb identiques dates, costs i configuracio.
// Dades 1D/4H: sempre ULTIMA vela tancada, mai la que esta en curs.

g1 = "01 | Hipotesi de recerca"
route = input.string("C · CONTINUACIO", "Motor (una sola via)",
     options=["C · CONTINUACIO", "B · RUPTURA-RETEST"], group=g1)
btcMode = input.string("INFORMATIU", "BTC 4H per altcoins",
     options=["INFORMATIU", "OBLIGATORI", "DESACTIVAT"], group=g1)
btcSymbol = input.symbol("BINANCE:BTCUSDT", "Referencia BTC mateix exchange", group=g1)
showPanel = input.bool(true, "Panell de comprovacions", group=g1)
showAudit = input.bool(true, "Ultimes cinc posicions", group=g1)
showLevels = input.bool(true, "Mostrar stop i objectiu", group=g1)

g2 = "02 | Finestra de prova (UTC)"
startDate = input.time(timestamp("01 Jan 2025 00:00 +0000"), "Inici inclusiu", group=g2)
endDate = input.time(timestamp("29 Oct 2026 00:00 +0000"), "Final exclusiu", group=g2)

// Presets congelats: no ajustar nomes per millorar el periode ja vist.
float riskFraction = 0.005       // 0.5% capital per stop teoric + costos
float allocationCap = 0.25      // maxim 25% del capital en nominal
float reserveCostPct = 0.002    // reserva anada+tornada estimada, no comissio real
float stopAtrBuffer = 0.20
float maxStopPct = 0.08
float maxExtensionAtr4 = 2.00
float maxEntryChaseAtr4 = 0.20
float targetR = 2.00
int expirationBars = 3
int cooldownBars = 8

if barstate.isfirst
    if timeframe.in_seconds() != 3600 or not chart.is_standard
        runtime.error("LONG AI v1.6: usa espelmes ESTANDARD d'1H")
    if syminfo.type != "crypto"
        runtime.error("LONG AI v1.6: accions bloquejades fins validar RTH i preus ajustats")
    if syminfo.currency != "USDT" and syminfo.currency != "USD"
        runtime.error("LONG AI v1.6: parell spot cotitzat en USD o USDT")
    if endDate <= startDate
        runtime.error("La data final ha de ser posterior a la inicial")

// Context superior: expresions [1] + lookahead_on = veles HTF confirmades.
[dClose, dEMA20, dEMA50, dEMA50Prev, dDollar, dHigh60, dBar] = request.security(
     syminfo.tickerid, "D",
     [close[1], ta.ema(close,20)[1], ta.ema(close,50)[1],
      ta.ema(close,50)[6], ta.sma(close*volume,20)[1],
      ta.highest(high,60)[1], bar_index[1]],
     lookahead=barmerge.lookahead_on)
[fClose, fClosePrev, fEMA20, fEMA50, fATR, fVol, fVolAvg, fBar] = request.security(
     syminfo.tickerid, "240",
     [close[1], close[2], ta.ema(close,20)[1], ta.ema(close,50)[1],
      ta.atr(14)[1], volume[1], ta.sma(volume,20)[2], bar_index[1]],
     lookahead=barmerge.lookahead_on)
f_dmi_confirmat() =>
    [p,m,a] = ta.dmi(14,14)
    [p[1],m[1],a[1]]
[diPlus,diMinus,adx4] = request.security(
     syminfo.tickerid,"240",f_dmi_confirmat(),lookahead=barmerge.lookahead_on)
f_macd_confirmat() =>
    [m,s,h] = ta.macd(close,12,26,9)
    [h[1],h[2]]
[macdH4,macdH4Prev] = request.security(
     syminfo.tickerid,"240",f_macd_confirmat(),lookahead=barmerge.lookahead_on)
[btcClose,btcEMA50] = request.security(
     btcSymbol,"240",[close[1],ta.ema(close,50)[1]],
     lookahead=barmerge.lookahead_on)

float ema1 = ta.ema(close,20)
float rsi1 = ta.rsi(close,14)
float atr1 = ta.atr(14)
float volumeBase = ta.sma(volume,20)[1]
float rvol1 = volumeBase>0 ? volume/volumeBase : na
float rvol4 = fVolAvg>0 ? fVol/fVolAvg : na
float previousHigh8 = ta.highest(high[1],8)
float previousLow8 = ta.lowest(low[1],8)
float previousHigh20 = ta.highest(high[1],20)
float previousHigh20Older = ta.highest(high[2],20)
float previousLow6 = ta.lowest(low[1],6)
float spreadRange = high-low
float closeLocation = spreadRange>0 ? (close-low)/spreadRange : 0.0
float vwap1 = ta.vwap(hlc3) // Context informatiu, no segon filtre de momentum.
float bbAverage = ta.sma(close,20)
float bbWidth = bbAverage>0 ? 4.0*ta.stdev(close,20)/bbAverage : na
float bbWidthMean = ta.sma(bbWidth,40)

bool inStudy = time>=startDate and time<endDate
bool historyOK = not na(dBar) and dBar>=70 and not na(fBar) and fBar>=70 and fATR>0 and not na(rvol1) and not na(adx4)
bool trendDaily = dClose>dEMA50 and dEMA50>=dEMA50Prev
bool trendFour = fClose>fEMA50 and fEMA20>=fEMA50*0.995
bool diUp = diPlus>diMinus and adx4>=16
bool macdUp = macdH4>=macdH4Prev
bool higherClose = fClose>fClosePrev
int confirmations = (diUp?1:0)+(macdUp?1:0)+(higherClose?1:0)
bool liquidityOK = dDollar>=1000000
bool btcFavorable = not na(btcClose) and not na(btcEMA50) and btcClose>btcEMA50
bool btcOK = btcMode!="OBLIGATORI" or syminfo.basecurrency=="BTC" or btcFavorable
bool notChasing = close<=fEMA20+maxExtensionAtr4*fATR
bool regimeOK = historyOK and trendDaily and trendFour and liquidityOK and confirmations>=2 and btcOK and notChasing

// VIA C: ruptura confirmada d'una base de 8 barres ANTERIORS, no repinta.
float consolidationRange = previousHigh8-previousLow8
bool baseC = consolidationRange>0 and consolidationRange<=1.60*fATR and previousLow8>fEMA50-0.20*fATR
bool impulseC = close>previousHigh8 and close>open and close>ema1 and rvol1>=1.10 and rsi1>=52 and rsi1<=76 and closeLocation>=0.60
bool signalC = regimeOK and fEMA20>fEMA50 and baseC and impulseC

// VIA B: ruptura guardada i retest d'una vela POSTERIOR (mai mateixa vela).
var float bLevel = na
var int bBreakIndex = na
bool firstBreak = barstate.isconfirmed and regimeOK and close>previousHigh20 and close[1]<=previousHigh20Older and close>open and rvol1>=1.20 and closeLocation>=0.60
if route=="B · RUPTURA-RETEST" and inStudy and firstBreak and strategy.position_size==0 and na(bBreakIndex)
    bLevel:=previousHigh20
    bBreakIndex:=bar_index
bool bWatching = not na(bBreakIndex) and bar_index>bBreakIndex and bar_index-bBreakIndex<=12
bool retestB = bWatching and low<=bLevel+0.30*fATR and low>=bLevel-0.60*fATR and close>bLevel and close>open and rvol1>=0.80 and rsi1>=48
bool signalB = regimeOK and retestB
if not na(bBreakIndex) and (bar_index-bBreakIndex>12 or close<bLevel-0.70*fATR or not inStudy)
    bBreakIndex:=na
    bLevel:=na

bool selectedSignal = route=="C · CONTINUACIO" ? signalC : signalB
float proposedTrigger = high+syminfo.mintick
float proposedStopC = math.min(previousLow8,low)-stopAtrBuffer*fATR
float proposedStopB = math.min(math.min(previousLow6,low),bLevel-0.20*fATR)-stopAtrBuffer*fATR
float proposedStop = route=="C · CONTINUACIO" ? proposedStopC : proposedStopB
float proposedRisk = proposedTrigger-proposedStop
float reserve = proposedTrigger*reserveCostPct
float goal = proposedTrigger+targetR*proposedRisk
float netRR = proposedRisk>0 ? (goal-proposedTrigger-reserve)/(proposedRisk+reserve) : na
// NO s'inventa resistencia ni probabilitat si el preu es en maxims.
bool realResistance = not na(dHigh60) and dHigh60>proposedTrigger+syminfo.mintick
float roomRR = realResistance and proposedRisk>0 ? (dHigh60-proposedTrigger-reserve)/(proposedRisk+reserve) : na
bool resistanceOK = not realResistance or roomRR>=targetR
bool planOK = proposedStop>0 and proposedRisk>syminfo.mintick and proposedRisk/proposedTrigger<=maxStopPct and netRR>=1.70 and resistanceOK

// Una SOLA posicio, una SOLA ordre bracket per evitar residus TP1/TP2.
var int pendingAt = na
var int lastFlatBar = na
var float trigger = na
var float stopPrice = na
var float targetPrice = na
var float plannedAtr = na
var float actualEntry = na
var float initialRisk = na
var float bestPriceAfterEntry = na
var int entryMs = na
var int entryBar = na
var int blockedRegime = 0
var int blockedSetup = 0
var int blockedPlan = 0
var int submitted = 0

bool waiting = not na(pendingAt) and strategy.position_size==0
bool cooldown = not na(lastFlatBar) and bar_index-lastFlatBar<cooldownBars
bool newSignal = barstate.isconfirmed and inStudy and selectedSignal and planOK and strategy.position_size==0 and not waiting and not cooldown
if barstate.isconfirmed and inStudy
    if not regimeOK
        blockedRegime+=1
    else if not selectedSignal
        blockedSetup+=1
    else if not planOK
        blockedPlan+=1

if newSignal
    float perUnitRisk = proposedRisk+reserve
    float rawQty = math.min(strategy.equity*riskFraction/perUnitRisk,strategy.equity*allocationCap/proposedTrigger)
    float lot = syminfo.mincontract
    float qty = lot>0 ? math.floor(rawQty/lot)*lot : rawQty
    if qty>0 and (lot<=0 or qty>=lot)
        pendingAt:=bar_index
        trigger:=proposedTrigger
        stopPrice:=proposedStop
        targetPrice:=goal
        plannedAtr:=fATR
        // Stop-limit entrada: es pot activar pero NO omplir a causa del limit.
        strategy.entry("L",strategy.long,qty=qty,stop=trigger,
             limit=trigger+maxEntryChaseAtr4*fATR,comment=route)
        // PROTECCIO EN LA MATEIXA BARRA DE SENYAL, no una hora mes tard.
        strategy.exit("L_BRACKET","L",stop=stopPrice,limit=targetPrice,
             comment_profit="OBJECTIU_2R",comment_loss="STOP_ESTRUCTURAL")
        submitted+=1
        if route=="B · RUPTURA-RETEST"
            bLevel:=na
            bBreakIndex:=na

// Retirar entrada pendent sense deixar ordres orfes.
if waiting and bar_index-pendingAt>=expirationBars
    strategy.cancel("L")
    strategy.cancel("L_BRACKET")
    pendingAt:=na
    trigger:=na
    stopPrice:=na
    targetPrice:=na

bool filledNow = strategy.position_size>0 and strategy.position_size[1]<=0
if filledNow
    actualEntry:=strategy.position_avg_price
    initialRisk:=math.max(actualEntry-stopPrice,syminfo.mintick)
    targetPrice:=actualEntry+targetR*initialRisk
    entryMs:=time
    entryBar:=bar_index
    bestPriceAfterEntry:=actualEntry

if strategy.position_size>0
    // Mai comptar el maxim de la barra de fill com si fos posterior al fill.
    if not na(entryBar) and bar_index>entryBar
        bestPriceAfterEntry:=math.max(bestPriceAfterEntry,high)
    strategy.exit("L_BRACKET","L",stop=stopPrice,limit=targetPrice,
         comment_profit="OBJECTIU_2R",comment_loss="STOP_ESTRUCTURAL")
    bool timeStop = time>=entryMs+7*86400000
    bool weakAfter3d = time>=entryMs+3*86400000 and bestPriceAfterEntry<actualEntry+0.50*initialRisk
    if barstate.isconfirmed and (timeStop or weakAfter3d)
        strategy.cancel("L_BRACKET")
        strategy.close("L",comment=timeStop?"SORTIDA_7D":"SENSE_IMPULS_3D")

bool justClosed = strategy.position_size==0 and strategy.position_size[1]>0
if justClosed
    strategy.cancel("L_BRACKET")
    lastFlatBar:=bar_index
    pendingAt:=na
    trigger:=na
    stopPrice:=na
    targetPrice:=na
    plannedAtr:=na
    actualEntry:=na
    initialRisk:=na
    bestPriceAfterEntry:=na
    entryMs:=na
    entryBar:=na

// Diagnostica bloquejos; els comptadors son BARRES, no trades perduts.
string missing = not inStudy?"FORA PERIODE":not historyOK?"HISTORIAL":not trendDaily?"TENDENCIA 1D":not trendFour?"TENDENCIA 4H":not liquidityOK?"LIQUIDITAT":confirmations<2?"FORCA 4H":not btcOK?"BTC DESFAVORABLE":not notChasing?"MASSA ESTES":not selectedSignal?"FALTA SETUP":not planOK?"STOP / R:R":"CONFIGURACIO"
string statusText = strategy.position_size>0?"POSICIO SIMULADA":waiting?"ORDRE PENDENT":cooldown?"COOLDOWN":newSignal?"NOU SETUP 1H":missing
float pf = strategy.grossloss<0 ? strategy.grossprofit/math.abs(strategy.grossloss) : na
string evidence = strategy.closedtrades<30 ? "MOSTRA <30: NO VALIDAT" : "COMPROVAR OOS + COSTOS"

var table board = table.new(position.top_right,2,12,border_width=1)
if barstate.islast and showPanel
    color navy=color.rgb(32,55,82)
    table.cell(board,0,0,"LONG AI v1.6 LAB",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,1,0,route,bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(board,0,1,"ESTAT",text_size=size.tiny)
    table.cell(board,1,1,statusText,text_size=size.tiny)
    table.cell(board,0,2,"TENDENCIA D/4H",text_size=size.tiny)
    table.cell(board,1,2,(trendDaily?"OK":"NO")+" / "+(trendFour?"OK":"NO"),text_size=size.tiny)
    table.cell(board,0,3,"FORCA 4H",text_size=size.tiny)
    table.cell(board,1,3,str.tostring(confirmations)+"/3 | ADX "+str.tostring(adx4,"#.0"),text_size=size.tiny)
    table.cell(board,0,4,"RSI / RVOL 1H",text_size=size.tiny)
    table.cell(board,1,4,str.tostring(rsi1,"#.0")+" | "+str.tostring(rvol1,"#.00")+"x",text_size=size.tiny)
    table.cell(board,0,5,"R/R NET / RESIST.",text_size=size.tiny)
    table.cell(board,1,5,str.tostring(netRR,"#.00")+" / "+(realResistance?str.tostring(roomRR,"#.00"):"NO IDENTIF."),text_size=size.tiny)
    table.cell(board,0,6,"BTC 4H",text_size=size.tiny)
    table.cell(board,1,6,btcMode=="DESACTIVAT"?"OFF":btcFavorable?"FAVORABLE":"FEBLE / NO DADES",text_size=size.tiny)
    table.cell(board,0,7,"VWAP / BB (INFO)",text_size=size.tiny)
    table.cell(board,1,7,(not na(vwap1) and close>vwap1?"SOBRE":"SOTA")+" / "+(bbWidth<bbWidthMean*.85?"COMP":"NORMAL"),text_size=size.tiny)
    table.cell(board,0,8,"BLOQUEJOS",text_size=size.tiny)
    table.cell(board,1,8,"REG "+str.tostring(blockedRegime)+" SETUP "+str.tostring(blockedSetup)+" RISC "+str.tostring(blockedPlan),text_size=size.tiny)
    table.cell(board,0,9,"PLANS / POSICIONS",text_size=size.tiny)
    table.cell(board,1,9,str.tostring(submitted)+" / "+str.tostring(strategy.closedtrades),text_size=size.tiny)
    table.cell(board,0,10,"RESULTAT / PF",text_size=size.tiny)
    table.cell(board,1,10,str.tostring(strategy.netprofit,"#.##")+" / "+(na(pf)?"--":str.tostring(pf,"#.##")),text_size=size.tiny)
    table.cell(board,0,11,"VALIDACIO",text_size=size.tiny)
    table.cell(board,1,11,evidence,text_size=size.tiny)

plot(fEMA20,"EMA20 4H TANCADA",color=color.orange)
plot(fEMA50,"EMA50 4H TANCADA",color=color.blue)
plot(showLevels and strategy.position_size>0?stopPrice:na,"STOP",color=color.red,style=plot.style_linebr)
plot(showLevels and strategy.position_size>0?targetPrice:na,"OBJECTIU 2R",color=color.lime,style=plot.style_linebr)
plotshape(newSignal,title="SETUP 1H",style=shape.triangleup,location=location.belowbar,color=color.teal,size=size.tiny)
plot(selectedSignal?1:0,"SENYAL BRUT 0/1",display=display.data_window)
plot(newSignal?1:0,"SETUP TRAMITAT 0/1",display=display.data_window)
plot(confirmations,"CONFIRMACIONS 4H 0-3",display=display.data_window)

var table audit = table.new(position.bottom_right,5,6,border_width=1)
if barstate.islast and showAudit
    color navy=color.rgb(32,55,82)
    table.cell(audit,0,0,"ENTRADA UTC",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(audit,1,0,"SORTIDA UTC",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(audit,2,0,"MOTIU",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(audit,3,0,"NET",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    table.cell(audit,4,0,"MFE/MAE",bgcolor=navy,text_color=color.white,text_size=size.tiny)
    for n=0 to 4
        int k=strategy.closedtrades-1-n
        int row=n+1
        if k>=0
            float netPnl=strategy.closedtrades.profit(k)-strategy.closedtrades.commission(k)
            table.cell(audit,0,row,str.format_time(strategy.closedtrades.entry_time(k),"MM-dd HH:mm","UTC"),text_size=size.tiny)
            table.cell(audit,1,row,str.format_time(strategy.closedtrades.exit_time(k),"MM-dd HH:mm","UTC"),text_size=size.tiny)
            table.cell(audit,2,row,strategy.closedtrades.exit_comment(k),text_size=size.tiny)
            table.cell(audit,3,row,str.tostring(netPnl,"#.##"),text_size=size.tiny,
                 bgcolor=netPnl>=0?color.rgb(221,243,229):color.rgb(253,226,226))
            table.cell(audit,4,row,str.tostring(strategy.closedtrades.max_runup(k),"#.0")+"/"+str.tostring(strategy.closedtrades.max_drawdown(k),"#.0"),text_size=size.tiny)
        else
            for col=0 to 4
                table.cell(audit,col,row,"",text_size=size.tiny)